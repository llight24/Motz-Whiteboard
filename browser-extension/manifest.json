{
  "manifest_version": 3,
  "name": "MOTZ 白板收集器",
  "version": "0.1.11",
  "description": "拖动网页图片到 MOTZ 悬浮入口，下载到素材库或发送到当前白板。",
  "permissions": ["storage", "contextMenus", "notifications"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:39875/*", "http://127.0.0.1:39876/*", "http://localhost:39875/*", "http://localhost:39876/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "MOTZ 白板收集器",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
